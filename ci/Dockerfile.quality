ARG BASE_IMAGE=sigdevelopers/sigportal-ci:v2.6
FROM rust:1.90.0-slim AS svg_rust
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      chromium \
      fonts-dejavu-core \
      fonts-liberation \
      libfreetype6 \
      poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# The tracked SVG adapter builds from Cargo.lock, never an ignored dependency patch.
COPY --from=svg_rust /usr/local/rustup /usr/local/rustup
COPY --from=svg_rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:${PATH}
